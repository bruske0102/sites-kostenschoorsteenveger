---
import Layout from "../layouts/Layout.astro";
import { getModel, scrapedListingCount, plaatsPath } from "../lib/data";

const m = getModel();
const jaar = new Date().getFullYear();
const totalListings = scrapedListingCount();
const grootste = [...m.plaatsenA].sort((a, b) => b.listings.length - a.listings.length).slice(0, 12);

const byProv = new Map<string, { naam: string; n: number; shops: number; b: number }>();
for (const p of m.plaatsenA) {
  const cur = byProv.get(p.provincie) ?? { naam: p.provincieNaam, n: 0, shops: 0, b: 0 };
  cur.n += 1;
  cur.shops += p.listings.length;
  byProv.set(p.provincie, cur);
}
for (const p of m.plaatsenB) {
  const cur = byProv.get(p.provincie) ?? { naam: p.provincieNaam, n: 0, shops: 0, b: 0 };
  cur.b += 1;
  byProv.set(p.provincie, cur);
}
const provs = [...byProv.entries()]
  .filter(([, info]) => info.shops > 0)
  .sort((a, b) => b[1].shops - a[1].shops);

const title = `Schoorsteenveger in de buurt — gids voor Nederland`;
const description = `Vind een schoorsteenveger bij jou: vergelijk ${totalListings} schoorsteenvegers in Nederland — met adres en telefoon.`;
---
<Layout title={title} description={description}>
  <section class="home-hero" aria-labelledby="home-h1">
    <p class="brand-lockup">Kostenschoorsteenveger.nl</p>
    <p class="eyebrow">{totalListings} schoorsteenvegers · heel Nederland · {jaar}</p>
    <h1 id="home-h1">Schoorsteenveger in de buurt?</h1>
    <p class="lead">
      Vergelijk schoorsteenvegers bij jou — prijsindicatie, adres en telefoon.
    </p>
    <form class="hero-search" action="/zoeken/" method="get" role="search">
      <label for="hero-q" class="skip">Zoek op plaats of schoorsteenveger</label>
      <input id="hero-q" name="q" type="search" placeholder="Bijv. Utrecht, Rotterdam, Amsterdam…" autocomplete="off" />
      <button type="submit">Zoeken</button>
    </form>
    <p class="hero-actions">
      <a class="btn" href="/offerte/">Gratis offertes</a>
      <a class="btn btn-ghost" href="/#provincies">Of kies een provincie</a>
    </p>
  </section>

  <section class="section" aria-labelledby="steden">
    <div class="section-head">
      <h2 id="steden">Populaire plaatsen</h2>
      <p>Meeste schoorsteenvegers in onze gids</p>
    </div>
    <ul class="linklist">
      {grootste.map((city) => (
        <li>
          <a href={plaatsPath(city)}>Schoorsteenveger {city.naam}</a>
          <span class="count">{city.listings.length}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section home-hub" aria-labelledby="hub">
    <div class="section-head">
      <h2 id="hub">Prijs & tarieven</h2>
      <p>Snel vergelijken in jouw regio</p>
    </div>
    <p class="section-lead">
      Niemand betaalt voor een hogere plek in de lijst.
    </p>
    <p class="home-hub-links">
      <a class="section-more" href="/offerte/">Vergelijk gratis offertes</a>
      <span aria-hidden="true"> · </span>
      <a class="section-more" href="/zoeken/">Zoek een schoorsteenveger</a>
      <span aria-hidden="true"> · </span>
      <a class="section-more" href="/bedrijf/toevoegen/">Gratis toevoegen</a>
    </p>
  </section>

  <section class="section" aria-labelledby="provincies" id="provincies">
    <div class="section-head">
      <h2 id="prov-h">Per provincie</h2>
    </div>
    <ul class="linklist">
      {provs.map(([slug, info]) => (
        <li>
          <a href={`/${slug}/`}>{info.naam}</a>
          <span class="count">{info.shops}</span>
        </li>
      ))}
    </ul>
  </section>
</Layout>
