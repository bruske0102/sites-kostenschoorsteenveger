---
import Layout from "../../layouts/Layout.astro";
---
<Layout
  title="Bedankt"
  description="Je offerteaanvraag is ontvangen."
  noindex
  zoekbaar={false}
  focus
  ads={false}
>
  <article class="offerte-thanks" data-pagefind-ignore>
    <header class="page-intro">
      <p class="offerte-kicker">Aanvraag ontvangen</p>
      <h1 class="page-title">Bedankt, we zetten je klus uit</h1>
      <p class="lead">
        Schoorsteenvegers in jouw regio nemen zo snel mogelijk contact op met informatie
        en vrijblijvende aanbiedingen.
      </p>
    </header>
    <p class="hero-actions">
      <a class="btn" href="/#provincies">Zoek een schoorsteenveger</a>
      <a class="btn btn-ghost" href="/">Terug naar home</a>
    </p>
  </article>
</Layout>

<style>
  .offerte-thanks {
    max-width: 38rem;
    margin: 0 auto 3rem;
    animation: rise-in 0.45s ease-out both;
  }

  .offerte-kicker {
    margin: 0 0 0.65rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .offerte-thanks .hero-actions {
    margin-top: 1.5rem;
  }
</style>
