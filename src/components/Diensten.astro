---
import type { City, Listing } from "../lib/model";
import { kenmerkCount } from "../lib/model";
import { listingCount, nlCount } from "../lib/nl-count";

interface Props { city: City; listings: Listing[] }
const { city, listings } = Astro.props;
const n = listings.length || city.listings;

const veegN = kenmerkCount(listings, /veeg/i);
const inspectN = kenmerkCount(listings, /inspect/i);
const erkendN = kenmerkCount(listings, /erkend/i);
const houtN = kenmerkCount(listings, /houtkachel/i);

const cards: { title: string; body: string }[] = [
  {
    title: "Adres & contact",
    body: `${listingCount(n)} in ${city.naam} met adres en telefoon in onze gids.`,
  },
];

if (veegN > 0) {
  cards.push({
    title: "Vegen",
    body: `${nlCount(veegN, "vermelding", "vermeldingen")} noemt schoorsteenvegen.`,
  });
}
if (inspectN > 0) {
  cards.push({
    title: "Inspectie",
    body: `${nlCount(inspectN, "vermelding", "vermeldingen")} noemt inspectie.`,
  });
}
if (erkendN > 0) {
  cards.push({
    title: "Erkend",
    body: `${nlCount(erkendN, "vermelding", "vermeldingen")} staat als erkend in de kenmerken.`,
  });
}
if (houtN > 0) {
  cards.push({
    title: "Houtkachel",
    body: `${nlCount(houtN, "vermelding", "vermeldingen")} noemt houtkachel-werk.`,
  });
}
if (cards.length < 3) {
  cards.push({
    title: "Afspraak",
    body: `Bel voor beschikbaarheid en prijs in ${city.naam} — vooral in het stookseizoen.`,
  });
}
---
<section class="section" aria-labelledby="diensten">
  <h2 id="diensten">Wat je in {city.naam} tegenkomt</h2>
  <p>Gebaseerd op de vermeldingen in onze gids — bel altijd voor actuele details.</p>
  <div class="diensten-grid">
    {cards.slice(0, 4).map((c) => (
      <div class="dienst">
        <h3>{c.title}</h3>
        <p>{c.body}</p>
      </div>
    ))}
  </div>
</section>
