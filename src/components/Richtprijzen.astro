---
interface Props { stad: string }
const { stad } = Astro.props;
---
<section class="section" aria-labelledby="tips-schoorsteen">
  <h2 id="tips-schoorsteen">Tips voor een schoorsteenveger in {stad}</h2>
  <div class="prijzen">
    <p>
      Handig om te weten voordat je belt:
    </p>
    <ul>
      <li>Vraag om een vaste prijs voor veegbeurt of inspectie</li>
      <li>Plan bij voorkeur vóór het stookseizoen</li>
      <li>Vermeld of je een open haard, kachel of kanalen hebt</li>
    </ul>
    <p class="fine">
      Geen landelijke vaste tarieven. Vergelijk adressen hierboven of
      <a href="/zoeken/">zoek landelijk</a>.
    </p>
  </div>
</section>
