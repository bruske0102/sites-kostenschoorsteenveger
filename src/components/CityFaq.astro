---
import type { City, Listing } from "../lib/model";
import { kenmerkCount } from "../lib/model";
import { listingCount } from "../lib/nl-count";

interface Props { city: City; listings: Listing[] }
const { city, listings } = Astro.props;
const n = listings.length || city.listings;
const veegN = kenmerkCount(listings, /veeg/i);
const inspectN = kenmerkCount(listings, /inspect/i);
const erkendN = kenmerkCount(listings, /erkend/i);
const houtN = kenmerkCount(listings, /houtkachel/i);

type Faq = { q: string; a: string };
const faqs: Faq[] = [
  {
    q: `Waar vind ik een schoorsteenveger in ${city.naam}?`,
    a: `Op deze pagina ${n === 1 ? "staat" : "staan"} ${listingCount(n)} in ${city.naam} met adres en telefoon. Bel voor een afspraak of prijsindicatie.`,
  },
  {
    q: `Wat kost een schoorsteenveger in ${city.naam}?`,
    a: `Kosten hangen af van veegbeurt, inspectie of houtkachel. Vraag om een vaste prijs voordat het werk start.`,
  },
];

if (veegN > 0) {
  faqs.push({
    q: `Wie veegt schoorstenen in ${city.naam}?`,
    a: `${veegN} vermelding${veegN === 1 ? "" : "en"} noemt vegen. Vraag naar beschikbaarheid in het stookseizoen.`,
  });
}
if (inspectN > 0) {
  faqs.push({
    q: `Kan ik een schoorsteeninspectie laten doen in ${city.naam}?`,
    a: `Ja — ${inspectN} vermelding${inspectN === 1 ? "" : "en"} noemt inspectie. Handig bij aankoop of na een lange stookperiode.`,
  });
}
if (erkendN > 0) {
  faqs.push({
    q: `Zijn er erkende schoorsteenvegers in ${city.naam}?`,
    a: `${erkendN} vermelding${erkendN === 1 ? "" : "en"} staat als erkend in onze kenmerken. Vraag naar certificering als je dat belangrijk vindt.`,
  });
}
if (houtN > 0) {
  faqs.push({
    q: `Helpen ze ook bij een houtkachel in ${city.naam}?`,
    a: `${houtN} vermelding${houtN === 1 ? "" : "en"} noemt houtkachel. Bel voor vegen of advies over veilige stook.`,
  });
}
---
<section class="section" aria-labelledby="faq">
  <h2 id="faq">Veelgestelde vragen over schoorsteenvegers in {city.naam}</h2>
  <div class="stack">
    {faqs.map((f) => (
      <article class="faq-item">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </article>
    ))}
  </div>
</section>
